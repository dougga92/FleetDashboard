# Copy to .env for local dev, or set these as App Service "Application settings" in Azure.

# Shared key every venue sends as the x-venue-key header. Must match each venue's
# TELEMETRY_KEY. Leave blank for local dev to accept any heartbeat.
INGEST_KEY=

# HTTP Basic auth for viewing the board. Leave DASHBOARD_PASSWORD blank to make
# the board open (dev only — always set a password in Azure).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# A venue is shown "offline" if its last heartbeat is older than this (seconds).
# Venues report ~every 45s, so ~150s tolerates a missed beat or two.
OFFLINE_AFTER_SEC=150

# Azure Communication Services HOURLY email send limit, shown as the ACS gauge
# (fleet ACS sends in the last 60 min / this cap; amber at 70%, red at 90%). Default 100.
ACS_HOURLY_EMAIL_CAP=100

# Port (App Service sets this automatically; only needed locally).
PORT=3000
